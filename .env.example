RPC_URI_FOR_1=
RPC_URI_FOR_10=
RPC_URI_FOR_42161=
RPC_URI_FOR_8453=

# Shared HMAC secret for Kong webhook signature verification
KONG_SECRET=dev-fapy-key

CRV_GAUGE_REGISTRY_URL=https://api.curve.finance/api/getAllGauges
CRV_POOLS_URL=https://api.curve.finance/api/getPools/all

# OpenTelemetry error reporting. Leave both endpoints unset to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT is an OTLP/HTTP base URL; `/v1/logs` is added.
# Sentry supplies a complete logs URL, which belongs in OTEL_EXPORTER_OTLP_LOGS_ENDPOINT.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=fapy-hook
